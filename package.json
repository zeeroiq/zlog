{
  "name": "zlog-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter zlog-backend dev",
    "dev:frontend": "pnpm --filter zlog-frontend dev",
    "dev:all": "pnpm --parallel --filter zlog-backend --filter zlog-frontend dev",
    "start": "pnpm --filter zlog-backend start",
    "build:backend": "pnpm --filter zlog-backend build",
    "build:frontend": "pnpm --filter zlog-frontend build",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "setup-owner": "pnpm --filter zlog-backend setup-owner",
    "test": "pnpm --filter zlog-backend test",
    "check": "pnpm test && pnpm build"
  }
}
